# คัดลอกเป็น server/.env แล้วแก้ตามเครื่องจริง (ห้าม commit server/.env)
# ทุกค่ามีค่าเริ่มต้น ไม่ตั้งก็ได้

# port ที่ proxy ฟัง
PORT=3000

# ค่า Access-Control-Allow-Origin — ใส่ origin ของหน้าเว็บจริงตอน deploy เช่น https://radio.example.com
ALLOWED_ORIGIN=http://localhost:5173

# IP/CIDR ของ Nginx ที่อนุญาตให้เชื่อ X-Forwarded-For (คั่นด้วยจุลภาคได้)
# ใน docker compose ให้ใส่ช่วง IP ของ docker network เช่น 172.16.0.0/12
TRUSTED_PROXY=127.0.0.1

# สตรีมพร้อมกันสูงสุดทั้งระบบ (เกิน → 503)
MAX_STREAMS=200

# สตรีมพร้อมกันสูงสุดต่อ IP (เกิน → 429)
MAX_STREAMS_PER_IP=3

# จำนวนครั้งที่เปิด /stream ได้ต่อ IP ต่อนาที (เกิน → 429)
RATE_LIMIT_PER_MIN=30

# อายุ cache ผล lookup uuid → URL (วินาที)
LOOKUP_TTL_SEC=600

# timeout ตอนเชื่อมต่อ upstream (มิลลิวินาที)
CONNECT_TIMEOUT_MS=8000

# timeout รอ response header จาก upstream (มิลลิวินาที)
HEADER_TIMEOUT_MS=10000

# ตัดสตรีมถ้าไม่มีข้อมูลเข้ามานานเกินนี้ (มิลลิวินาที)
IDLE_TIMEOUT_MS=30000

# User-Agent ที่ใช้คุยกับ Radio Browser API
RB_USER_AGENT=khlun-thai-proxy/1.0
